# Phase B persists fictional payment attempts and a durable Kafka outbox.
GLARAMARA_SESSION_SECRET=
GLARAMARA_PUBLIC_ORIGIN=http://127.0.0.1:3000
GLARAMARA_COOKIE_SECURE=false
DATABASE_URL=
# Safe local default. Use orchestrate only in an explicitly authenticated server process.
FRAUD_INTELLIGENCE_PROVIDER=mock
FRAUD_INTELLIGENCE_MODEL=groq/openai/gpt-oss-120b
FRAUD_INTELLIGENCE_TIMEOUT_MS=45000
FRAUD_RULE_DISCOVERY_PROVIDER=mock
FRAUD_RULE_DISCOVERY_AGENT_ID=
FRAUD_RULE_DISCOVERY_MODEL=mock-fraud-rule-discovery/1.0.0
FRAUD_RULE_DISCOVERY_TIMEOUT_MS=60000
# Server-only IBM Cloud settings. Never use NEXT_PUBLIC_ names for either value.
WATSONX_ORCHESTRATE_API_KEY=
WATSONX_ORCHESTRATE_URL=
