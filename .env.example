# Generated automatically as .env by `make build` or `make up`.
POSTGRES_DB=fraud_demo
POSTGRES_USER=fraud_app
POSTGRES_PASSWORD=generated_locally_do_not_reuse
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Non-conflicting host ports for the isolated development deployment.
KAFKA_HOST_PORT=19092
POSTGRES_HOST_PORT=55433
FLINK_HOST_PORT=18081
CORRELATOR_HOST_PORT=18082
SHADOW_ENGINE_HOST_PORT=18083
GLARAMARA_HOST_PORT=3000
GLARAMARA_PUBLIC_ORIGIN=http://localhost:3000
GLARAMARA_SESSION_SECRET=generated_locally_do_not_reuse_or_commit
GLARAMARA_COOKIE_SECURE=false
NEW_BENEFICIARY_HIGH_VALUE_THRESHOLD_GBP=5000
FRAUD_INTELLIGENCE_PROVIDER=mock
FRAUD_INTELLIGENCE_MODEL=mock-fraud-intelligence/1.0.0
FRAUD_INTELLIGENCE_TIMEOUT_MS=45000
# Server-only; required only when FRAUD_INTELLIGENCE_PROVIDER=orchestrate.
WATSONX_ORCHESTRATE_API_KEY=
WATSONX_ORCHESTRATE_URL=

# Optional resource overrides for small local Podman machines.
KAFKA_HEAP_OPTS="-Xms256m -Xmx512m"
JOBMANAGER_MEMORY=768m
TASKMANAGER_MEMORY=1280m
