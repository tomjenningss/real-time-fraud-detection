# Non-conflicting host ports for the isolated development deployment.
KAFKA_HOST_PORT=19092
POSTGRES_HOST_PORT=55433
FLINK_HOST_PORT=18081
CORRELATOR_HOST_PORT=18082
SHADOW_ENGINE_HOST_PORT=18083
GLARAMARA_HOST_PORT=13000
GLARAMARA_PUBLIC_ORIGIN=http://127.0.0.1:13000
GLARAMARA_SESSION_SECRET=generated_locally_do_not_reuse_or_commit
