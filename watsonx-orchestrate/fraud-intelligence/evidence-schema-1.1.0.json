{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fraud-intelligence-evidence/1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "paymentRecognition",
    "beneficiaryRelationship",
    "paymentPurpose",
    "thirdPartyInfluence",
    "verificationClaims",
    "scamIndicators",
    "contradictions",
    "uncertainty",
    "missingEvidence",
    "provenance",
    "clarificationQuestion"
  ],
  "properties": {
    "schemaVersion": {"const": "fraud-intelligence-evidence/1.1.0"},
    "paymentRecognition": {"enum": ["RECOGNISED", "NOT_RECOGNISED", "UNCERTAIN"]},
    "beneficiaryRelationship": {"enum": ["KNOWN", "NEW", "UNCERTAIN"]},
    "paymentPurpose": {
      "enum": ["GOODS_OR_SERVICES", "FRIENDS_OR_FAMILY", "INVESTMENT", "SAFE_ACCOUNT", "OTHER", "UNCERTAIN"]
    },
    "thirdPartyInfluence": {
      "enum": ["NONE", "EXPECTED", "UNEXPECTED", "BANK_IMPERSONATION", "UNCERTAIN"]
    },
    "verificationClaims": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 3,
      "items": {
        "enum": ["MET_BENEFICIARY_IN_PERSON", "CHECKED_BENEFICIARY_DETAILS", "INVOICE_RECEIVED"]
      }
    },
    "scamIndicators": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "enum": ["UNEXPECTED_CONTACT", "PRESSURE_OR_SECRECY", "URGENCY", "SAFE_ACCOUNT",
          "BANK_IMPERSONATION", "THIRD_PARTY_BENEFICIARY", "INVESTMENT", "REMOTE_ACCESS", "NONE"]
      }
    },
    "contradictions": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "sourceQuestionIds"],
        "properties": {
          "summary": {"type": "string", "minLength": 1, "maxLength": 240},
          "sourceQuestionIds": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 6,
            "items": {"type": "string", "minLength": 1, "maxLength": 96}
          }
        }
      }
    },
    "uncertainty": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "missingEvidence": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 96}
    },
    "provenance": {
      "type": "array",
      "minItems": 4,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "claim", "sources"],
        "properties": {
          "findingId": {"type": "string", "minLength": 1, "maxLength": 96},
          "claim": {"type": "string", "minLength": 1, "maxLength": 240},
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["questionId", "excerpt"],
              "properties": {
                "questionId": {"type": "string", "minLength": 1, "maxLength": 96},
                "excerpt": {"type": "string", "minLength": 1, "maxLength": 500}
              }
            }
          }
        }
      }
    },
    "clarificationQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["needed", "id", "prompt", "options", "reason"],
      "properties": {
        "needed": {"type": "boolean"},
        "id": {"type": "string", "maxLength": 80},
        "prompt": {"type": "string", "maxLength": 200},
        "options": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 4,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        },
        "reason": {"type": "string", "maxLength": 160}
      }
    }
  }
}
