{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fraud-rule-proposal/1.0.0",
  "title": "Glaramara Fraud Rule Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ruleIdentifier", "name", "description", "rationale", "logicalOperator", "conditions", "action", "supportingEvidenceRefs", "limitations", "uncertainty", "agentVersion"],
  "properties": {
    "schemaVersion": {"const": "fraud-rule-proposal/1.0.0"},
    "ruleIdentifier": {"type": "string", "pattern": "^FRD-[A-Z0-9-]{3,64}$"},
    "name": {"type": "string", "minLength": 3, "maxLength": 100},
    "description": {"type": "string", "minLength": 10, "maxLength": 600},
    "rationale": {"type": "string", "minLength": 10, "maxLength": 1200},
    "logicalOperator": {"const": "ALL"},
    "conditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["featureId", "operator", "threshold", "window"],
        "properties": {
          "featureId": {
            "enum": [
              "amount_gbp",
              "beneficiary_payment_count_before",
              "customer_transaction_count",
              "customer_total_amount_gbp",
              "customer_distinct_merchant_count",
              "customer_distinct_new_beneficiary_count",
              "customer_new_beneficiary_payment_count",
              "customer_new_beneficiary_total_gbp",
              "beneficiary_distinct_customers"
            ]
          },
          "operator": {"enum": ["GT", "GTE", "LT", "LTE", "EQ"]},
          "threshold": {"type": "number", "minimum": 0, "maximum": 10000000},
          "window": {"enum": ["PT1M", "PT2M", "PT10M", "PT24H", null]}
        }
      }
    },
    "action": {"const": "CHALLENGED"},
    "supportingEvidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "uncertainty": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "agentVersion": {"const": "1.0.0"}
  }
}

