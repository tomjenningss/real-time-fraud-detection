# Anthropic authentication
ANTHROPIC_API_KEY=replace_with_your_api_key

# Claude models
ANTHROPIC_SUPERVISOR_MODEL=claude-opus-5-5
ANTHROPIC_GEO_MODEL=claude-haiku-5-5
ANTHROPIC_BEHAVIOUR_MODEL=claude-sonnet-5-5
ANTHROPIC_ACTION_MODEL=claude-haiku-5-5

# Execution
AGENT_MODE=dry-run
MAX_TOOL_ITERATIONS=6
AGENT_TIMEOUT_SECONDS=30
MAX_OUTPUT_TOKENS=1024

# Cost control
MAX_INVESTIGATION_COST_USD=0.20
LIVE_SMOKE_TEST_LIMIT=1
LIVE_EXPERIMENT_ID=part3-live-eval-001
LIVE_EXPERIMENT_BUDGET_GBP=1.00
# Set both values below only for a separately approved USD-denominated experiment.
LIVE_EXPERIMENT_BUDGET_CURRENCY=GBP
# LIVE_EXPERIMENT_BUDGET_USD=2.00
# Explicit evaluation assumption: GBP 1.00 = USD 1.30. Update only by creating/reviewing an experiment.
LIVE_USD_PER_GBP=1.30
LIVE_BASELINE_COST_USD=0.0274
LIVE_MAX_INVESTIGATIONS=5
LIVE_INVESTIGATION_RESERVE_USD=0.20
LIVE_MAX_MODEL_CALLS=12
LIVE_REMAINING_CALL_RESERVE_USD=0.005
LIVE_INPUT_TOKEN_SAFETY_MULTIPLIER=1.5

# Pricing metadata in USD per million tokens (review when provider pricing changes)
PRICE_OPUS_INPUT_MTOK_USD=4.00
PRICE_OPUS_OUTPUT_MTOK_USD=20.00
PRICE_SONNET_INPUT_MTOK_USD=2.00
PRICE_SONNET_OUTPUT_MTOK_USD=10.00
PRICE_HAIKU_INPUT_MTOK_USD=0.10
PRICE_HAIKU_OUTPUT_MTOK_USD=0.50

# Audit
AUDIT_ENABLED=true

# Optional Phoenix/OpenTelemetry tracing. Direct-on-Mac endpoint shown; from a container use
# http://host.containers.internal:6006/v1/traces (or the Phoenix Compose service hostname).
OTEL_ENABLED=false
OTEL_SERVICE_NAME=fraud-investigation-worker
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:6006/v1/traces
OTEL_EXPORT_TIMEOUT_SECONDS=2
PHOENIX_PROJECT_NAME=fraud-investigations
# Development-only: exports redacted prompts/outputs. Use only with synthetic evidence.
OTEL_CAPTURE_SYNTHETIC_CONTENT=false

# Part 3 services (use the real password only in ignored fraud-decisioning/.env or process environment)
DATABASE_URL=postgresql://fraud_app:replace_me@localhost:5433/fraud_demo
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ROUTER_GROUP_ID=fraud-decision-router-v1
ROUTER_AUTO_OFFSET_RESET=latest
# Required only on the first start of a new router group; example for one partition:
ROUTER_EXPECTED_START_OFFSETS=0:123
INVESTIGATION_AUTO_OFFSET_RESET=latest
INVESTIGATION_EXPECTED_START_OFFSETS=0:123
INVESTIGATION_GROUP_ID=fraud-investigation-worker-v1
NORMAL_INVESTIGATION_SAMPLE_RATE=0
MAX_INVESTIGATION_ATTEMPTS=3
MAX_INVESTIGATIONS_PER_RUN=1
INVESTIGATION_CONCURRENCY=1
LIVE_INVESTIGATIONS_ENABLED=false
LIVE_INVESTIGATIONS_APPROVED=false
